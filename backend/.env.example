# ============================================================
# FinAgent AI — Backend Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Core Django
SECRET_KEY=replace-with-a-long-random-secret-key-min-50-chars
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost

# MongoDB — use Atlas URI for production
MONGO_URI=mongodb://localhost:27017
MONGO_URI_FALLBACK=
DB_NAME=finagent_ai
MONGO_TRANSACTIONS_COLLECTION=transactions

# MongoDB TLS (only needed for local Windows dev with Atlas)
MONGO_TLS_ALLOW_INVALID_CERTS=false
MONGO_TLS_DISABLE_OCSP=false
MONGO_SERVER_SELECTION_TIMEOUT_MS=20000
MONGO_CONNECT_TIMEOUT_MS=20000
MONGO_SOCKET_TIMEOUT_MS=20000

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=8

# Qdrant — leave blank to skip vector search and use regex fallback
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=transactions
QDRANT_VECTOR_SIZE=384
# For Qdrant Cloud:
# QDRANT_URL=https://your-cluster.qdrant.io
# QDRANT_API_KEY=your-api-key

# LLM
LLM_FALLBACK_ORDER=groq,huggingface
LLM_TIMEOUT_SEC=12

# Groq (primary LLM)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Hugging Face (fallback LLM)
HF_API_KEY=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_BASE_URL=https://router.huggingface.co/v1/chat/completions
