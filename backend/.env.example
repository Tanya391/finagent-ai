# Backend env template
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost

# MongoDB
MONGO_URI=mongodb://localhost:27017
# Optional fallback URI if primary Mongo is unavailable
MONGO_URI_FALLBACK=
DB_NAME=finance_ai
MONGO_TRANSACTIONS_COLLECTION=transactions
MONGO_TLS_ALLOW_INVALID_CERTS=false
MONGO_TLS_DISABLE_OCSP=false
MONGO_SERVER_SELECTION_TIMEOUT_MS=20000
MONGO_CONNECT_TIMEOUT_MS=20000
MONGO_SOCKET_TIMEOUT_MS=20000
# If using MongoDB Atlas and seeing TLS handshake issues, set:
# MONGO_TLS_DISABLE_OCSP=true

# Embeddings / Vector Search
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_INDEX_NAME=transactions_vector_index
RAG_TOP_K=8

# LLM fallback order: first available successful provider wins
LLM_FALLBACK_ORDER=groq,huggingface
LLM_TIMEOUT_SEC=25

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Hugging Face (Inference Providers, OpenAI-compatible endpoint)
HF_API_KEY=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_BASE_URL=https://router.huggingface.co/v1/chat/completions


